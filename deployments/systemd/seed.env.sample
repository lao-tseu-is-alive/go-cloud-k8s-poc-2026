# /etc/goeland/seed.env — settings of goeland-demo-reset.service (demo-seed, then migrate), as the
# schema owner (deployments/systemd/README.md). Copy, fill the placeholders, chmod 600 root:root:
# systemd reads it as root before running the commands as goeland. Values are never quoted.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_MODE=disable
# Same database as the server; goeland-demo-recreate-db creates it owned by DB_USER.
DB_NAME=goeland_demo
DB_USER=goeland_owner
DB_PASSWORD=<owner-password>
DATABASE_URL=
GOELAND_DB_MIGRATE=auto
# The runtime role `goeland-server migrate` grants after the migrations (the server's DB_USER).
GOELAND_DB_APP_ROLE=goeland_app

# demo-seed acts as the demo users whatever the mode; demo needs no auth secret to load.
GOELAND_AUTH_MODE=demo
GOELAND_BLOB_STORE=file
# Same document path as the server, under /var/lib/goeland/demo_documents (the reset empties it).
GOELAND_DOCUMENT_PATH=/var/lib/goeland/demo_documents/fr
# fr or en
GOELAND_DEMO_LANG=fr
# demo: the stories and their background (DEMO_SCRIPT §5, a few minutes); small: the stories only.
GOELAND_DEMO_PROFILE=demo
LOG_LEVEL=info
