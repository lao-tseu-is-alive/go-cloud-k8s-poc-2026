# /etc/goeland/config.env — settings of goeland.service (the server), here serving the synthetic
# demo (deployments/systemd/README.md). Copy, fill the placeholders, chmod 640 root:goeland.
# Every variable the server reads, with its default, is listed in .env_sample at the repository root.
# Values are never quoted.
GOELAND_LISTEN_ADDRESS=127.0.0.1:8080
LOG_LEVEL=info

# The runtime role: rows only, no DDL (GLD-046). DATABASE_URL must stay empty: it would win over DB_*.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_MODE=disable
DB_NAME=goeland_demo
DB_USER=goeland_app
DB_PASSWORD=<app-password>
DATABASE_URL=
# The server never migrates: goeland-demo-reset.service does, as the schema owner.
GOELAND_DB_MIGRATE=verify

# Demo mode: the sign-in screen lists the demo users; the server refuses a database demo-seed did not generate.
GOELAND_AUTH_MODE=demo
GOELAND_BLOB_STORE=file
GOELAND_DOCUMENT_PATH=/var/lib/goeland/demo_documents/fr

# Metrics on a separate, private listener (empty = off).
GOELAND_METRICS_ADDRESS=
