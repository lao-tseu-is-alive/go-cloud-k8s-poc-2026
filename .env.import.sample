# Copy to .env.import (Git-ignored) and fill in: the connections of the legacy
# import only (scripts/import_rebuild.sh, docs/IMPORT_MAPPING.md). Kept out of
# .env on purpose: the Makefile exports every .env variable to the server, which
# needs neither the replica nor the superuser. Values are not quoted.
# A variable already set in the environment wins over this file.

# The legacy replica, read-only role.
GOELAND_IMPORT_SOURCE_URL=postgres://postgres@127.0.0.1:5432/goeland
# A PostgreSQL superuser, to drop and recreate the goeland_import* target.
GOELAND_IMPORT_ADMIN_URL=postgres://postgres@127.0.0.1:5432/postgres
