{
  "name": "goeland-front",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "test": "vitest run",
    "lint:fix": "eslint --fix",
    "mcp": "ruler apply",
    "mcp:revert": "ruler revert"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "7.4.47",
    "vue": "^3.5.43",
    "vuetify": "^4.2.4",
    "pinia": "^3.0.4",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@intellectronica/ruler": "^0.3.37",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.105.1",
    "typescript": "~5.9.3",
    "unplugin-fonts": "^1.4.0",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "unplugin-fonts": {
      "vite": "^8.0.0"
    }
  }
}
