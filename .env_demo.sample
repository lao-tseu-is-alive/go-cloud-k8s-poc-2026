# Demo settings for scripts/demo_seed.sh -e (GLD-079, docs/DEMO_SCRIPT.md §7).
# Copy it to a Git-ignored .env_demo_<profile>_<lang> file, e.g. .env_demo_small_fr. It completes
# .env (which keeps the database role and its password): put no secret here. Values are not quoted.

# The demo database (created when missing; never the development database of .env).
DB_NAME=goeland_demo_small_fr
# An empty DATABASE_URL lets DB_NAME win over the DATABASE_URL of .env.
DATABASE_URL=
# Language of the generated texts: fr or en.
GOELAND_DEMO_LANG=fr
# Keep the demo documents apart from the development ones (Git-ignored directory).
GOELAND_BLOB_STORE=file
GOELAND_DOCUMENT_PATH=./demo_documents/small_fr

# To serve the demo as one of its users (docs/DEMO_SCRIPT.md §7), here Bruno.
GOELAND_AUTH_MODE=dev
GOELAND_DEV_USER_ID=2
GOELAND_DEV_USER_NAME=Bruno Favre
GOELAND_DEV_USER_EMAIL=bruno.favre@example.ch
