# Copy this file to .env and adapt it to your needs. Every variable the server reads is listed
# here with its default; the reference is docs/PRODUCTION_READINESS.md (section numbers below).
# NEVER commit .env — it holds your passwords and keys. Use secrets in CI (e.g. GitHub secrets).
# Do not quote values: the Makefile includes and exports this file, so quotes become part of the value.

######### SERVER CONFIGURATION (§6) #########
GOELAND_LISTEN_ADDRESS=127.0.0.1:8080
GOELAND_SHUTDOWN_TIMEOUT_SECONDS=10
GOELAND_REQUEST_TIMEOUT_SECONDS=10

######### LOG CONFIGURATION #########
# LOG_LEVEL: debug, info, warn, error
LOG_LEVEL=info

######### DATABASE CONFIGURATION (§1, §2) #########
# PostgreSQL 14+ with the PostGIS, pgcrypto, pg_trgm and unaccent extensions available.
# DATABASE_URL wins over the DB_* variables when set (DB_DRIVER is read by the Makefile's dbmate only).
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=goeland_poc_db
DB_USER=goeland_poc_db
DB_PASSWORD=<db-password>
DB_SSL_MODE=prefer
DATABASE_URL=postgres://goeland_poc_db:<db-password>@127.0.0.1:5432/goeland_poc_db?sslmode=prefer
GOELAND_DB_MAX_CONNECTIONS=10
# How long startup retries an unreachable database (0-600 s; 0 = a single attempt).
GOELAND_DB_CONNECT_TIMEOUT_SECONDS=60
# auto: migrate at startup (local work); verify: only check that no migration is pending, the schema
# owner running `goeland-server migrate` (production, two roles, GLD-046).
GOELAND_DB_MIGRATE=auto
# Read by `goeland-server migrate` only: the runtime role granted after the migrations (empty = none).
GOELAND_DB_APP_ROLE=

######### AUTHENTICATION (§4) #########
# jwt (default): verify tokens issued by go-cloud-k8s-auth (JWT settings below) + introspect PATs (pat_...).
# dev: accept GOELAND_DEV_TOKEN for one explicit local development user.
GOELAND_AUTH_MODE=dev
# https outside loopback (PATs are sent to it), unless GOELAND_ALLOW_INSECURE_AUTH_URL=true.
AUTH_SERVER_URL=http://localhost:9090
GOELAND_ALLOW_INSECURE_AUTH_URL=false
GOELAND_DEV_TOKEN=<dev-token>
GOELAND_DEV_USER_ID=1
GOELAND_DEV_USER_EMAIL=dev@localhost
GOELAND_DEV_USER_NAME=Local Goeland User
# dev mode only: make the dev user an administrator (ADMIN role, bootstrapped; default false)
GOELAND_DEV_USER_ADMIN=false
# user ids granted the ADMIN role on their next request (comma-separated, at most 20; empty = none).
# The recovery path when no administrator is left; see GET /api/me for your user id.
GOELAND_BOOTSTRAP_ADMINS=

######### JSON WEB TOKEN CONFIGURATION (jwt mode, §4) #########
# Both at least 16 characters, the same values as go-cloud-k8s-auth.
JWT_SECRET=<jwt-secret>
JWT_ISSUER_ID=<jwt-issuer-id>

######### DOCUMENT CONTENT STORAGE (§3) #########
# Backend of new content bytes: file (local directory, default) or s3 (S3-compatible bucket, GLD-020).
GOELAND_BLOB_STORE=file
# Local directory of the file backend; with s3, the bytes stored there before stay readable.
GOELAND_DOCUMENT_PATH=./go_documents
# Per-upload cap in bytes (default 100 MiB).
GOELAND_MAX_UPLOAD_BYTES=104857600
# Uploaded bytes never attached to a document are destroyed after this delay (1-720 h, GLD-045),
# checked every GOELAND_ORPHAN_SCAN_MINUTES (1-1440).
GOELAND_ORPHAN_UPLOAD_TTL_HOURS=24
GOELAND_ORPHAN_SCAN_MINUTES=60

######### S3 STORAGE (GOELAND_BLOB_STORE=s3, §3, GLD-020) #########
# Tested against Garage. The bucket must exist (checked at startup); the key needs read and write on
# it, nothing more (Garage: `garage bucket allow --read --write <bucket> --key <key-name>`).
# URL of the S3 API: https, or http to a loopback host (Garage on this machine: http://127.0.0.1:3900).
GOELAND_S3_ENDPOINT=
# The region the endpoint signs for (Garage: s3_region in its configuration, often "garage").
GOELAND_S3_REGION=
GOELAND_S3_BUCKET=
# Optional key prefix inside the bucket, for a bucket shared by several deployments.
GOELAND_S3_PREFIX=
# The access key ID (Garage: the "Key ID" GK..., not the key name) and its secret; never logged.
GOELAND_S3_ACCESS_KEY_ID=
GOELAND_S3_SECRET_ACCESS_KEY=
# Accept a plain-http endpoint outside loopback (e.g. a service-mesh encrypted cluster).
GOELAND_S3_ALLOW_PLAIN_HTTP=false

######### CASE EXPORTS (§3, GLD-029) #########
# How long a built archive stays downloadable (1-720 h) and how often the worker polls (1-3600 s).
GOELAND_EXPORT_TTL_HOURS=24
GOELAND_EXPORT_POLL_SECONDS=5

######### RETENTION (§11, docs/RETENTION.md, GLD-077) #########
# Exactly true lets an elimination bordereau destroy records; otherwise it is only simulated.
GOELAND_DISPOSAL_ENABLED=false

######### TRANSACTIONAL OUTBOX (§6, GLD-028) #########
GOELAND_OUTBOX_RETENTION_DAYS=7
GOELAND_OUTBOX_POLL_SECONDS=5
# Log every delivered outbox event.
GOELAND_OUTBOX_LOG=false

######### OBSERVABILITY (§9 metrics, §10 traces, GLD-010) #########
# host:port of the Prometheus metrics listener (never the public port; empty = off).
GOELAND_METRICS_ADDRESS=
# OTLP/HTTP collector for traces (empty = off; or OTEL_EXPORTER_OTLP_TRACES_ENDPOINT for traces only);
# OTEL_SDK_DISABLED=true turns them off again.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=false

######### TESTS ("Verifying a deployment") #########
# Disposable databases and stores only: never your working database or your own Garage.
# GOELAND_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/goeland_test?sslmode=disable
# GOELAND_TEST_S3_* are written by scripts/garage_test_server.sh start <env-file>.
